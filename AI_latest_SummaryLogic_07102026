private static readonly TimeSpan BusinessDayStart = new(5, 30, 0);

/// <summary>
/// A piece of an activity clipped to ONE business day (05:30 IST to 05:30 IST).
/// </summary>
private sealed record ActivitySegment(
    MasterActivityLog Activity,   // original row
    DateOnly LogDate,             // business date of THIS segment
    DateTime IstStartTime,        // clipped start (IST)
    DateTime IstEndTime,          // clipped end (IST)
    long DurationSeconds,         // clipped duration
    bool IsCarryOver);            // true = continuation after the 05:30 boundary

private static DateOnly GetBusinessDate(DateTime ist) =>
    DateOnly.FromDateTime(
        ist.TimeOfDay < BusinessDayStart ? ist.AddDays(-1) : ist);

/// <summary>
/// Splits an activity at every 05:30 IST boundary it crosses.
/// </summary>
private static IEnumerable<ActivitySegment> SplitByBusinessDay(MasterActivityLog a)
{
    var start = Formatter.ConvertUtcToIst(a.StartTime);
    var end = Formatter.ConvertUtcToIst(a.EndTime);

    // Bad / zero-length data: keep as-is, no splitting
    if (end <= start)
    {
        yield return new ActivitySegment(
            a, GetBusinessDate(start), start, end, a.DurationSeconds, false);
        yield break;
    }

    var cursor = start;
    var isFirst = true;

    while (cursor < end)
    {
        var businessDate = GetBusinessDate(cursor);

        // The 05:30 that closes this business day
        var boundary = businessDate
            .AddDays(1)
            .ToDateTime(TimeOnly.FromTimeSpan(BusinessDayStart));

        var segEnd = end < boundary ? end : boundary;
        var notSplit = isFirst && segEnd == end;

        yield return new ActivitySegment(
            a,
            businessDate,
            cursor,
            segEnd,
            notSplit
                ? a.DurationSeconds                       // keep stored value
                : (long)(segEnd - cursor).TotalSeconds,   // clipped value
            !isFirst);

        cursor = segEnd;
        isFirst = false;
    }
}

