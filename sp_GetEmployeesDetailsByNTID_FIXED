ALTER PROCEDURE [dbo].[sp_GetEmployeesDetailsByNTID]
    @NTId NVARCHAR(100)
AS
BEGIN
    SET NOCOUNT ON;

    SELECT TOP (1)
        me.GLOBAL_ID AS EmployeeCode,
        me.FullName,
        me.Email,
        me.DEPARTMENT
    FROM EmployeeNetworkMapping AS enm
    INNER JOIN vw_MasterEmployee AS me
        ON me.EmployeeCode = enm.EmployeeCode
        OR me.GLOBAL_ID = enm.EmployeeCode
    WHERE enm.NetworkId = @NTId
    ORDER BY me.GLOBAL_ID;  -- deterministic tiebreaker; swap for whichever
                             -- column should win if you have a preference
                             -- (e.g. an IsActive flag, ModifiedDate DESC, etc.)
END
